<div class="max-w-4xl mx-auto">
  <%= form_with(model: family, class: "space-y-6", data: { controller: "member-numbering form-progress" }) do |form| %>
    <% if family.errors.any? %>
      <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">
              <%= pluralize(family.errors.count, "erro") %> encontrado<%= family.errors.count > 1 ? 's' : '' %>
            </h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc list-inside space-y-1">
                <% family.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Seção 1: Identificação da Família -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-b border-gray-200 px-6 py-4">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
              <span class="text-white text-sm font-semibold">1</span>
            </div>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-semibold text-gray-900">Identificação da Família</h3>
            <p class="text-sm text-gray-600">Informações básicas para identificar a família</p>
          </div>
        </div>
      </div>
      
      <div class="p-6 space-y-6">
        <div class="group">
          <%= form.label :reference_name, class: "block text-sm font-medium text-gray-700 mb-2" do %>
            Nome de Referência
          <% end %>
          <%= form.text_field :reference_name, 
              class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm",
              placeholder: "Ex: Família da Maria, Casa do João" %>
          <p class="mt-1 text-xs text-gray-500">Para facilitar a busca, esta família é conhecida na comunidade</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="group">
            <%= form.label :phone1, class: "block text-sm font-medium text-gray-700 mb-2" do %>
              <svg class="inline w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Telefone Principal
            <% end %>
            <%= form.text_field :phone1, 
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm",
                placeholder: "(XX) X XXXX-XXXX",
                data: { controller: "phone-mask" } %>
          </div>

          <div class="group">
            <%= form.label :phone2, class: "block text-sm font-medium text-gray-700 mb-2" do %>
              <svg class="inline w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Telefone Alternativo
            <% end %>
            <%= form.text_field :phone2, 
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm",
                placeholder: "(XX) X XXXX-XXXX",
                data: { controller: "phone-mask" } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Seção 2: Endereço -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-b border-gray-200 px-6 py-4">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center">
              <span class="text-white text-sm font-semibold">2</span>
            </div>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-semibold text-gray-900">Endereço</h3>
            <p class="text-sm text-gray-600">Localização da residência</p>
          </div>
        </div>
      </div>
      
      <div class="p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-6 gap-6">
          <div class="md:col-span-4">
            <%= form.label :street, class: "block text-sm font-medium text-gray-700 mb-2" do %>
              <svg class="inline w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Rua <span class="text-red-500">*</span>
            <% end %>
            <%= form.text_field :street, 
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm",
                required: true %>
          </div>

          <div class="md:col-span-2">
            <%= form.label :house_number, "Número", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :house_number, 
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm" %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <%= form.label :neighborhood, "Bairro", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :neighborhood, 
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :city, "Cidade", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :city, value: "Vitória da Conquista", 
                class: "block w-full rounded-lg border-gray-300 bg-gray-50 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :state, "Estado", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :state, value: "Bahia", 
                class: "block w-full rounded-lg border-gray-300 bg-gray-50 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Seção 3: Membros da Família -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="bg-gradient-to-r from-purple-50 to-pink-50 border-b border-gray-200 px-6 py-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center">
                <span class="text-white text-sm font-semibold">3</span>
              </div>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-semibold text-gray-900">Membros da Família</h3>
              <p class="text-sm text-gray-600">Adicione todos os membros que moram na casa</p>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-sm text-gray-500">Total:</span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800" data-member-count="0">
              0 membros
            </span>
          </div>
        </div>
      </div>
      
      <div class="p-6">
        <div id="member_fields" class="space-y-4" data-controller="nested-form member-form">
          <%= form.fields_for :members do |member_form| %>
            <div class="member-fields transition-all duration-300" data-member-index="<%= member_form.object.id || member_form.index %>" data-controller="member-form">
              <%= render 'member_fields', f: member_form %>
            </div>
          <% end %>
        </div>
        
        <div class="mt-6 text-center">
          <%= link_to_add_association form, :members, 
              class: "inline-flex items-center px-6 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5",
              data: { 
                association_insertion_node: '#member_fields', 
                association_insertion_method: 'append',
                action: "click->member-numbering#memberAdded"
              } do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
            Adicionar Membro
          <% end %>
        </div>
      </div>
    </div>

    <!-- Seção 4: Informações da Moradia -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="bg-gradient-to-r from-orange-50 to-red-50 border-b border-gray-200 px-6 py-4">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-orange-500 rounded-full flex items-center justify-center">
              <span class="text-white text-sm font-semibold">4</span>
            </div>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-semibold text-gray-900">Informações da Moradia</h3>
            <p class="text-sm text-gray-600">Tipo de moradia e situação financeira</p>
          </div>
        </div>
      </div>
      
      <div class="p-6 space-y-6" data-controller="housing-type">
        <div class="bg-gray-50 rounded-lg p-4">
          <div class="flex flex-col space-y-4">
            <div>
              <%= form.label :housing_type, "Tipo de moradia", class: "block text-sm font-medium text-gray-700 mb-3" %>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <label class="relative flex items-center p-4 border rounded-lg cursor-pointer hover:bg-blue-50 transition-colors duration-200">
                  <%= form.radio_button :housing_type, 'own', 
                      class: "sr-only",
                      data: { action: "housing-type#toggle", "housing-type-target": "ownRadio" } %>
                  <div class="flex items-center">
                    <div class="w-4 h-4 border-2 border-gray-300 rounded-full mr-3 flex items-center justify-center">
                      <div class="w-2 h-2 bg-blue-600 rounded-full hidden"></div>
                    </div>
                    <div>
                      <div class="text-sm font-medium text-gray-900">Casa própria</div>
                      <div class="text-xs text-gray-500">Família possui a casa</div>
                    </div>
                  </div>
                </label>
                
                <label class="relative flex items-center p-4 border rounded-lg cursor-pointer hover:bg-blue-50 transition-colors duration-200">
                  <%= form.radio_button :housing_type, 'rented', 
                      class: "sr-only",
                      data: { action: "housing-type#toggle", "housing-type-target": "rentedRadio" } %>
                  <div class="flex items-center">
                    <div class="w-4 h-4 border-2 border-gray-300 rounded-full mr-3 flex items-center justify-center">
                      <div class="w-2 h-2 bg-blue-600 rounded-full hidden"></div>
                    </div>
                    <div>
                      <div class="text-sm font-medium text-gray-900">Casa alugada</div>
                      <div class="text-xs text-gray-500">Família paga aluguel</div>
                    </div>
                  </div>
                </label>
              </div>
            </div>

            <div data-housing-type-target="financedSection" class="<%= 'hidden' unless family.housing_type == 'own' %>">
              <label class="flex items-center p-3 bg-blue-50 rounded-lg">
                <%= form.check_box :financed_house, 
                    class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500 mr-3",
                    data: { action: "housing-type#toggleFinancing", "housing-type-target": "financedCheckbox" } %>
                <span class="text-sm font-medium text-gray-700">Casa financiada?</span>
              </label>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div data-housing-type-target="financingValueSection" class="<%= 'hidden' unless family.housing_type == 'own' && family.financed_house %>">
            <%= form.label :financing_value, "Valor do financiamento", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <div class="relative rounded-lg shadow-sm">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <span class="text-gray-500 sm:text-sm">R$</span>
              </div>
              <%= form.number_field :financing_value, step: '0.01', 
                  class: "block w-full rounded-lg border-gray-300 pl-8 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm" %>
            </div>
          </div>

          <div data-housing-type-target="rentValueSection" class="<%= 'hidden' unless family.housing_type == 'rented' %>">
            <%= form.label :rent_value, "Valor do aluguel", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <div class="relative rounded-lg shadow-sm">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <span class="text-gray-500 sm:text-sm">R$</span>
              </div>
              <%= form.number_field :rent_value, step: '0.01', 
                  class: "block w-full rounded-lg border-gray-300 pl-8 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm" %>
            </div>
          </div>

          <div>
            <%= form.label :family_income, "Renda familiar", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg p-4 border border-blue-200">
              <div class="flex items-center">
                <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div>
                  <div class="text-sm font-medium text-blue-900">Cálculo automático</div>
                  <div class="text-xs text-blue-700">Soma da renda de todos os membros</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Seção 5: Cesta Básica -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="bg-gradient-to-r from-teal-50 to-cyan-50 border-b border-gray-200 px-6 py-4">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-teal-500 rounded-full flex items-center justify-center">
              <span class="text-white text-sm font-semibold">5</span>
            </div>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-semibold text-gray-900">Cesta Básica</h3>
            <p class="text-sm text-gray-600">Informações sobre o benefício da cesta básica</p>
          </div>
        </div>
      </div>
      
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <%= form.label :food_basket_start_date, "Data de início", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.date_field :food_basket_start_date, 
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :food_basket_duration_months, "Duração (meses)", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.number_field :food_basket_duration_months, 
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 sm:text-sm",
                min: 1, max: 24 %>
          </div>
        </div>
        
        <div class="mb-6">
          <%= form.label :food_basket_status, "Status da Cesta Básica (opcional)", class: "block text-sm font-medium text-gray-700 mb-3" %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <% Family.valid_food_basket_statuses.each do |status| %>
              <label class="relative flex items-center p-3 border rounded-lg cursor-pointer hover:bg-gray-50 transition-colors duration-200">
                <%= form.radio_button :food_basket_status, status, class: "sr-only" %>
                <div class="flex items-center">
                  <div class="w-4 h-4 border-2 border-gray-300 rounded-full mr-3 flex items-center justify-center">
                    <div class="w-2 h-2 bg-blue-600 rounded-full hidden"></div>
                  </div>
                  <span class="text-sm font-medium text-gray-900"><%= status_label(status) %></span>
                </div>
              </label>
            <% end %>
          </div>
          <p class="mt-3 text-sm text-gray-500 bg-gray-50 p-3 rounded-lg">
            <svg class="inline w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Preencher apenas se necessário. Caso não informe, nenhum status será definido.
          </p>
        </div>
        
        <div class="bg-blue-50 rounded-lg p-4">
          <label class="flex items-center">
            <%= form.check_box :auto_update_status, 
                class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 mr-3" %>
            <div>
              <span class="text-sm font-medium text-gray-900">Atualizar status automaticamente</span>
              <p class="text-xs text-gray-600">O sistema atualizará o status com base nas datas informadas (se você preencher).</p>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- Botões de Ação -->
    <div class="sticky bottom-0 bg-white border-t border-gray-200 px-6 py-4 flex justify-between items-center shadow-lg rounded-t-lg">
      <div class="flex items-center text-sm text-gray-500">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        Dados salvos automaticamente
      </div>
      
      <div class="flex space-x-3">
        <%= link_to "Cancelar", families_path, 
            class: "px-6 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all duration-200" %>
        
        <%= form.submit "Salvar Família", 
            class: "px-6 py-2 text-sm font-medium text-white bg-gradient-to-r from-blue-600 to-indigo-600 border border-transparent rounded-lg shadow-sm hover:from-blue-700 hover:to-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all duration-200" %>
      </div>
    </div>
  <% end %>
</div>

<style>
  /* Melhorias de animação e interatividade */
  .member-container {
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 16px;
    transition: all 0.3s ease;
    position: relative;
  }

  .member-container:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .group:focus-within .group-label {
    color: #3b82f6;
  }

  /* Animações para radio buttons personalizados */
  input[type="radio"]:checked + div .w-2 {
    display: block;
  }

  input[type="radio"]:checked + div .w-4 {
    border-color: #3b82f6;
    background-color: #eff6ff;
  }

  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Loading states */
  .loading {
    opacity: 0.6;
    pointer-events: none;
  }

  /* Focus improvements */
  .focus-visible:focus {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }
</style>
