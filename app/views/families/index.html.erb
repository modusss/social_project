<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% content_for :title, "Families" %>

  <h1 class="text-3xl font-bold text-center mb-6">Lista de Famílias</h1>

  <%= render 'shared/navigation_tabs' %>

  <%= render 'shared/view_toggle_buttons' %>

  <%= render 'shared/search_form' %>

  <%= render 'shared/food_basket_filters' %>

  <%= render 'shared/sort_filters' %>

  <%= render 'shared/results_counter', collection: @families, singular_label: 'família encontrada', plural_label: 'famílias encontradas' %>

  <!-- Conditional rendering based on view preference -->
  <div id="families_content">
    <% if params[:view] == 'card' %>
      <%= render 'card_view', families: @families, rows: @rows %>
    <% else %>
      <%= render 'table', rows: @rows %>
    <% end %>
  </div>

  <div class="mt-6 flex justify-center">
    <%= paginate @families, theme: 'tailwind', window: 2,
      class: "pagination",
      previous_label: '← Anterior',
      next_label: 'Próxima →' %>
  </div>
</div>
