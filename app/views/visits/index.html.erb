<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% content_for :title, "Visitas" %>

  <h1 class="text-3xl font-bold text-center mb-6">Lista de Visitas</h1>

  <%= render 'shared/navigation_tabs' %>

  <%= render 'shared/view_toggle_buttons' %>

  <%= render 'shared/search_form' %>

  <%= render 'shared/food_basket_filters' %>

  <%= render 'shared/sort_filters' %>

  <%= render 'shared/results_counter', collection: @visits, singular_label: 'visita encontrada', plural_label: 'visitas encontradas' %>

  <div id="visits_content">
    <% if params[:view] == 'table' %>
      <%= render 'table_index', visits_data: @visits_data %>
    <% else %>
      <%= render 'card_view', visits: @visits, visits_data: @visits_data %>
    <% end %>
  </div>
  
  <div class="mt-6 flex justify-center">
    <%= paginate @visits, theme: 'tailwind', window: 2,
      class: "pagination",
      previous_label: '← Anterior',
      next_label: 'Próxima →' %>
  </div>
</div>


